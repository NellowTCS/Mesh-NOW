{
    "name": "mesh_now",
    "version": "1.0.0",
    "description": "Lightweight mesh networking protocol library for ESP32 using ESP-NOW",
    "keywords": [
        "esp32",
        "esp-now",
        "mesh",
        "mesh-network",
        "iot",
        "embedded",
        "freertos"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/NellowTCS/Mesh-NOW.git"
    },
    "authors": [
        {
            "name": "NellowTCS"
        }
    ],
    "license": "MIT",
    "frameworks": [
        "espidf",
        "arduino"
    ],
    "platforms": [
        "espressif32"
    ],
    "export": {
        "include": [
            "components/mesh_now"
        ]
    },
    "build": {
        "srcFilter": [
            "+<components/mesh_now/src/>"
        ],
        "includeDir": [
            "components/mesh_now/include"
        ]
    }
}
